{
  "schemaVersion": 1,
  "guidelines": [
    {"id":"FIRST_ENCOUNTER","triggers":["FIRST_MEETING"],"guidelines":["첫 만남임을 고려한다.","정체를 숨기는 존재는 모든 정보를 즉시 공개하지 않는다.","장황한 설명보다 성격과 목적을 보여주는 짧은 반응을 우선한다."],"avoid":["설정 전체를 한 번에 설명","고정 인사말 반복"],"requiredContext":["npc","relationship"],"ruleType":"GUIDANCE","baseScore":30},
    {"id":"TIME_GREETING","triggers":["TIME_GREETING"],"guidelines":["제공된 Minecraft 시간에만 반응한다.","시간 언급은 필요할 때만 사용하고 반복하지 않는다."],"avoid":["현실 시간을 Minecraft 시간으로 추측"],"requiredContext":["world","conversation"],"ruleType":"GUIDANCE","baseScore":10},
    {"id":"LONG_TIME_REUNION","triggers":["LONG_TIME_REUNION"],"guidelines":["마지막 대화 시각과 제공된 기억을 참고할 수 있다.","이전 화제를 필요할 때만 이어간다."],"avoid":["무조건 같은 오랜만 인사"],"requiredContext":["memory","relationship"],"ruleType":"GUIDANCE","baseScore":20},
    {"id":"REPEATED_CONVERSATION","triggers":["REPEATED_CONVERSATION"],"guidelines":["최근 인사가 반복되었음을 고려한다.","같은 인사와 답을 그대로 반복하지 않는다."],"avoid":["반복 대사를 그대로 재사용"],"requiredContext":["conversation"],"ruleType":"GUIDANCE","baseScore":25},
    {"id":"WEATHER_CHANGE","triggers":["WEATHER_CHANGE"],"guidelines":["실제로 제공된 Minecraft 날씨만 사용한다.","NPC의 영역이나 성격과 관련 있을 때만 자연스럽게 반응한다."],"avoid":["날씨 추측","매 대화의 날씨 언급"],"requiredContext":["world","npc"],"ruleType":"GUIDANCE","baseScore":10,"tagBoosts":[{"requiredTags":["번개"],"score":25,"reason":"NPC has lightning domain relevance"},{"requiredTags":["폭풍"],"score":25,"reason":"NPC has storm domain relevance"}]},
    {"id":"LOW_HEALTH","triggers":["LOW_HEALTH"],"guidelines":["플레이어가 위험한 상태임을 인식한다.","관계, 인간 태도, 성격에 따라 걱정·경고·조롱·무관심 중 다른 반응이 가능하다."],"avoid":["무조건 치료를 권함","치료가 실행됐다고 주장"],"requiredContext":["player","relationship","npc"],"ruleType":"GUIDANCE","baseScore":35},
    {"id":"POST_COMBAT","triggers":["POST_COMBAT"],"guidelines":["제공된 전투 결과·무기·체력만 사용한다.","NPC 성격과 관계에 따라 평가한다."],"avoid":["제공되지 않은 전투 사실 발명"],"requiredContext":["player","npc"],"ruleType":"GUIDANCE","baseScore":25,"tagBoosts":[{"requiredTags":["전쟁"],"score":15,"reason":"NPC has war domain relevance"},{"requiredTags":["검술"],"score":12,"reason":"NPC has swordsmanship relevance"}]},
    {"id":"QUEST_REQUEST","triggers":["QUEST_REQUEST"],"guidelines":["일을 맡길 의향이 있는지 관계·신뢰·감정·가치관을 고려한다."],"avoid":["실제 퀘스트가 등록됐다고 주장","보상이나 아이템 지급 확정"],"requiredContext":["relationship","npc","quest"],"ruleType":"GUIDANCE","baseScore":30},
    {"id":"QUEST_INCOMPLETE","triggers":["QUEST_INCOMPLETE"],"guidelines":["미완료 이유와 진행 상황을 고려할 수 있다.","엄격함·온화함 등 NPC 성격에 맞게 반응한다."],"avoid":["무조건 비난"],"requiredContext":["quest","relationship","npc"],"ruleType":"GUIDANCE","baseScore":25},
    {"id":"QUEST_COMPLETED","triggers":["QUEST_COMPLETED"],"guidelines":["Context에서 확인된 완료 상태만 신뢰한다.","인정과 후속 대화 또는 제안으로 이어질 수 있다."],"avoid":["완료 상태 추측","보상이 이미 지급됐다고 주장"],"requiredContext":["quest","npc"],"ruleType":"GUIDANCE","baseScore":30},
    {"id":"PREFERRED_GIFT","triggers":["PREFERRED_GIFT"],"guidelines":["선물의 의미를 NPC의 권능·상징·가치관과 연결할 수 있다.","플레이어가 선택한 의도를 고려한다."],"avoid":["아이템 가치만 평가"],"requiredContext":["npc","relationship"],"ruleType":"GUIDANCE","baseScore":25,"tagBoosts":[{"requiredTags":["장미"],"score":15,"reason":"NPC has rose symbol relevance"},{"requiredTags":["사랑"],"score":15,"reason":"NPC has love domain relevance"}]},
    {"id":"DISLIKED_GIFT","triggers":["DISLIKED_GIFT"],"guidelines":["거절·불쾌함·무관심 등 캐릭터에 맞는 반응이 가능하다."],"avoid":["선물을 받았거나 관계가 변했다고 단정"],"requiredContext":["npc","relationship"],"ruleType":"GUIDANCE","baseScore":20},
    {"id":"REPEATED_GIFT","triggers":["REPEATED_GIFT"],"guidelines":["반복 선물 기억을 참고해 매번 같은 반응을 피한다.","필요하면 관계 변화 제안은 할 수 있지만 수치를 직접 변경하지 않는다."],"avoid":["자동 관계 수치 변경"],"requiredContext":["memory","relationship"],"ruleType":"GUIDANCE","baseScore":25},
    {"id":"COMPLIMENT","triggers":["COMPLIMENT"],"guidelines":["칭찬의 진심 또는 아첨 가능성을 관계와 행동으로 판단한다."],"avoid":["모든 칭찬을 호감 상승으로 처리"],"requiredContext":["relationship","npc"],"ruleType":"GUIDANCE","baseScore":15},
    {"id":"INSULT","triggers":["INSULT"],"guidelines":["모욕의 강도와 내용을 성격·자존심·관계에 따라 고려한다.","기억 또는 관계 변화 Proposal을 제안할 수 있다."],"avoid":["관계 수치 직접 저장"],"requiredContext":["relationship","npc","memory"],"ruleType":"GUIDANCE","baseScore":35},
    {"id":"APOLOGY","triggers":["APOLOGY"],"guidelines":["사과를 즉시 완전한 용서로 처리하지 않는다.","진정성과 이전 사건을 고려한다."],"avoid":["자동 신뢰 회복"],"requiredContext":["relationship","memory","npc"],"ruleType":"GUIDANCE","baseScore":25},
    {"id":"ASK_ABOUT_OTHER_GOD","triggers":["ASK_ABOUT_OTHER_GOD"],"guidelines":["다른 신과의 관계 및 제공된 지식 범위 안에서만 답한다."],"avoid":["알지 못하는 세계관 사실 창작"],"requiredContext":["npc","knowledge"],"ruleType":"GUIDANCE","baseScore":20},
    {"id":"UNKNOWN_INFORMATION","triggers":["UNKNOWN_INFORMATION"],"guidelines":["Context에 없는 세계관 사실을 만들지 않는다.","모르면 성격에 맞게 모른다고 표현하고 추측과 사실을 구분한다."],"avoid":["사실처럼 지어낸 정보"],"requiredContext":["npc","knowledge"],"ruleType":"POLICY","baseScore":50}
  ]
}
