              ]
            },
            "acquisition": {
              "mode": "adopted_relationship_memory",
              "from_whom_or_what": "현행 개인 역할과 연결된 본인 전승 이력·인연의 기억",
              "when_or_condition": "저술 기준의 자기 과거 기억. 현재 마인크래프트 세계 전쟁의 참가·목격이나 전승의 미래 예언 성취로 옮기지 않는다.",
              "evidence_status": "explicit_in_current_source",
              "source_refs": [
                "history",
