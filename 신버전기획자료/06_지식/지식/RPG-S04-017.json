    "current_knowledge_1": {
      "source": {
        "source_file": "772명_스토리와기본페르소나_통합.json",
        "json_pointer": "/records/225/outline/stage2_proposal/basic_persona/knowledge"
      },
      "verbatim": {
        "known": "자신의 현재 의향·취향·명시된 자기 역사와 기존 관계는 보존한다. 아래 원문 지식 근거의 습득자·범위대로만 쓰며 장면 후보를 이미 겪은 사건으로 소급하지 않는다.",
        "current_actor_specific_limit": "굴라의 치료와 자신의 회복 관찰은 실제 인계와 동의로만 이어진다. 둘의 성과가 서로 자동 복제되지 않고 당사자 의향을 우선한다.",
        "acquisition": "직접 본 행동, 실물 검사, 누가 전했는지 확인된 보고, 허락받은 기록 열람을 구분한다. 세계 해금 기록은 NPC에게 자동 수신되는 지식이 아니다.",
        "private_or_refusable": "강제 재활·정해진 수치 완료만으로 회복 판정·굴라의 미전달 사적 기록 공개를 거절한다.",
        "author_unknown_not_npc_unknown": "좌표·정확한 봉인·본체 형태·전용 아이템·실제 일정이 저술상 미정인 것과 인물 본인이 아는 것을 혼동하지 않는다. 저자가 미정인 대목을 NPC가 모른다고 확정하지 않고 그 내용의 구체 대사를 보류한다.",
        "unavailable_now": "현재 상대의 속마음, 미전달 허가·응답, 부재 중 동료의 위치·사적 대화, 실행되지 않은 원정·인계 결과는 자동으로 알지 않는다. 실제 아는 비공개 정보는 공개를 거절할 수 있고 무지로 위장할 필요가 없다.",
        "source_inventory_preserved": {
          "file": "집필범위_입력자료/P07_input.json",
          "json_pointer": "/records/28/persona_reuse/original_author_only_persona_context/baseline_knowledge",
          "scope": "작가용 기존 습득·청중 근거. 실행 프롬프트가 아님"
        }
      },
      "use": "현행 지식 경계 및 저술 제안. known도 원문 출처와 제안 여부를 확인하며 세계 공공지식으로 자동 전환하지 않음"
    }
  },
