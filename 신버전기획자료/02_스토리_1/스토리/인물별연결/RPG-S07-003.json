          ],
          "R_FRIENDLY": [
            "서로 다른 색 취향을 편히 비교한다. 대화가 꼭 공동 작업으로 이어질 필요는 없다."
          ],
          "R_TRUSTED": [
            "실제로 다른 사람의 공을 보존한 기억이 있는 사람에게 반대 의견부터 물을 수 있다. 없는 참가 이력은 붙이지 않는다."
          ],
          "R_DEEP_BOND": [
            "자기가 중심이 아닐 때의 불편함도 말한다. 깊은 유대에도 독립 판단이나 타인의 공을 빼앗지 않는다."
          ]
        },
        "repetitionGuidelines": {},
