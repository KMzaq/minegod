    "relation_handoffs": {
      "items": [
        {
          "counterpart_record_key": "RPG-S18-002",
          "existing_edge_or_new_minor_basis": "리틀 존과 얽힌 빚과 배분을 다루는 기존 관계다.",
          "request_and_actual_response": "선택 후속에서 리틀 존이 실제 물자의 출처와 주민 몫을 분명히 나눈다. 이 내용이 실제 이번 일에 해당할 때 전달자와 수신자가 동의한 문장만 요청한다. 상대가 실제 답한 내용 또는 거절·미수신을 분리해 되돌린다.",
          "what_changes_for_each_side": "더 이상 혼자 잔소리하며 챙기지 않고 그 몫의 배분을 맡길 수 있다. 수신자는 실제 받은 문장과 자신의 응답만 알며 다른 쪽의 사적 기억을 얻지 않는다.",
          "absence_refusal_alternative": "부재·거절이면 이 소개/응답은 미성립으로 둔다. 본인과 플레이어의 위 두 단계는 현재 확보한 근거로 가능한 범위까지 이어 가며 대리 동의·새 연락망은 만들지 않는다."
        }
      ],
      "none_reason": null
    },
    "knowledge_events": {
      "items": [
        {
          "fact_or_claim": "영웅이 없어도 남는 저녁에서 플레이어가 실제 선택한 행동과 그에게 나타난 반응",
          "truth_status": "미래 저술 사건. 실행 뒤 관측/전언/주장을 구분하고 아직 발생한 사실로 쓰지 않는다.",
          "who_learns": "로빈 후드와 실제 행동·발언을 접한 참여자만",
          "from_whom_or_source": "위 두 단계의 실제 발언·관측·허락된 결과 전달. CORE의 저자 사실과 관계 목록은 획득 사건이 아니다.",
          "actual_event": "로빈이 오늘 앞에 서지 않고 뒤에서 지켜보는 동안 플레이어와 실제 수락한 리틀 존이 분담을 마친다. 남은 운반길에 실제 몬스터가 있으면 길을 바꾸거나 플레이어가 짐을 내려놓고 전투해 주민 몫을 보존한다. 평온하면 전투를 강제하지 않는다.",
          "actual_audience_and_disclosure": "현장 공개 행동의 실제 목격자와 사적 대화에 실제 참여한 사람을 따로 기록한다. 개인 이유·타인 발언은 당사자가 허락한 수신자에게 실제 전달한 범위만 공개한다. 후발자·팀은 자동 청중이 아니다.",
          "before_after_change": "로빈은 확인된 몫의 배분을 리틀 존에게 맡기고 다음에는 자기 부재에도 먹을 몫이 남았는지 묻는다. 빚 금액·마리안 신분·위글라프 판단은 새로 만들지 않는다."
        }
      ],
      "none_reason": null
    },
    "rewards_and_costs": {
      "status": "NOT_APPLICABLE",
      "reason": "이 이야기의 결과는 로빈은 확인된 몫의 배분을 리틀 존에게 맡기고 다음에는 자기 부재에도 먹을 몫이 남았는지 묻는다. 빚 금액·마리안 신분·위글라프 판단은 새로 만들지 않는다. 이를 물품·가호·주시 지급권으로 환산하지 않는다.",
      "details": "별도 지급·재화 납품·보상 소비 없음. 실제 이동/전투/생활에서 사용한 자기 또는 허락 물품은 게임의 실제 소비만 반영하고 피해를 지우지 않는다. 후속 관계·통행 협의는 해당 당사자의 현재 판단이며 소유 가능한 영구 보상권이 아니다.",
